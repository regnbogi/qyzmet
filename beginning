  final List<String> subcategories;

  const SubcategoryScreen({
    super.key,
    required this.icon,
    required this.title,
    required this.subcategories,
    required this.city,
  });

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF2F2F7),
      body: SafeArea(
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(8, 12, 24, 0),
              child: CupertinoButton(
                padding: EdgeInsets.zero,
                onPressed: () => Navigator.pop(context),
                child: const Row(
                  children: [
                    Icon(
                      CupertinoIcons.chevron_left,
                      color: Color(0xFF007AFF),
                      size: 20,
                    ),
                    Text(
                      'Назад',
                      style: TextStyle(color: Color(0xFF007AFF), fontSize: 17),
                    ),
                  ],
                ),
              ),
            ),
            Padding(
              padding: const EdgeInsets.fromLTRB(24, 16, 24, 4),
              child: Row(
                children: [
                  Text(icon, style: const TextStyle(fontSize: 36)),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      title,
                      style: const TextStyle(
                        fontSize: 26,
                        fontWeight: FontWeight.w700,
                        letterSpacing: -0.5,
                      ),
                    ),
                  ),
                ],
              ),
            ),
            Padding(
              padding: const EdgeInsets.fromLTRB(24, 0, 24, 16),
              child: Text(
                '📍 $city',
                style: const TextStyle(fontSize: 14, color: Color(0xFF8E8E93)),
              ),
            ),
            Expanded(
              child: ListView.separated(
                padding: const EdgeInsets.symmetric(horizontal: 24),
                itemCount: subcategories.length,
                separatorBuilder: (_, __) => const Divider(
                  height: 1,
                  indent: 16,
                  color: Color(0xFFE5E5EA),
                ),
                itemBuilder: (context, index) {
                  return _SubItem(
                    name: subcategories[index],
                    onTap: () => Navigator.push(
                      context,
                      CupertinoPageRoute(
                        builder: (_) => MastersScreen(
                          category: subcategories[index],
                          city: city,
                        ),
                      ),
                    ),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}

class _SubItem extends StatefulWidget {
  final String name;
  final VoidCallback onTap;
  const _SubItem({required this.name, required this.onTap});

  @override
  State<_SubItem> createState() => _SubItemState();
}

class _SubItemState extends State<_SubItem> {
  bool _pressed = false;

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTapDown: (_) => setState(() => _pressed = true),
      onTapUp: (_) {
        setState(() => _pressed = false);
        widget.onTap();
      },
      onTapCancel: () => setState(() => _pressed = false),
      child: AnimatedOpacity(
        opacity: _pressed ? 0.5 : 1.0,
        duration: const Duration(milliseconds: 80),
        child: Container(
          color: Colors.white,
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 16),
          child: Row(
            children: [
              Text(
                widget.name,
                style: const TextStyle(fontSize: 16, color: Color(0xFF000000)),
              ),
              const Spacer(),
              const Icon(
                CupertinoIcons.chevron_right,
                color: Color(0xFFC7C7CC),
                size: 14,
              ),
            ],
          ),
        ),
      ),
    );
  }
}

