class _CategoryList extends StatelessWidget {
  final Color accent;
  final ValueChanged<String> onSelect;
  const _CategoryList({required this.accent, required this.onSelect});

  @override
  Widget build(BuildContext context) {
    return ListView.separated(
      padding: EdgeInsets.zero,
      itemCount: categoryData.length,
      separatorBuilder: (_, __) =>
          Divider(height: 1, color: Colors.black.withOpacity(0.05)),
      itemBuilder: (context, i) {
        final cat = categoryData[i];
        return GestureDetector(
          onTap: () => onSelect(cat['title']),
          child: Container(
            color: Colors.transparent,
            padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
            child: Row(
              children: [
                Text(cat['icon'], style: const TextStyle(fontSize: 24)),
                const SizedBox(width: 14),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        cat['title'],
                        style: const TextStyle(
                          fontSize: 15,
                          fontWeight: FontWeight.w600,
                          color: Color(0xFF1C1C1E),
                        ),
                      ),
                      Text(
                        '${(cat['subcategories'] as List).length} специализаций',
                        style: const TextStyle(
                          fontSize: 12,
                          color: Color(0xFF8E8E93),
                        ),
                      ),
                    ],
                  ),
                ),
                Icon(CupertinoIcons.chevron_right, size: 14, color: accent),
              ],
            ),
          ),
        );
      },
    );
  }
}

class _SubcategoryList extends StatelessWidget {
  final String category;
  final Color accent;
  final List<Color> gradColors;
  final List<String> selected;
  final ValueChanged<String> onSelect;
  const _SubcategoryList({
    required this.category,
    required this.accent,
    required this.gradColors,
    required this.selected,
    required this.onSelect,
  });

  @override
  Widget build(BuildContext context) {
    final cat = categoryData.firstWhere((c) => c['title'] == category);
    final subs = List<String>.from(cat['subcategories']);

    return ListView.separated(
      padding: EdgeInsets.zero,
      itemCount: subs.length,
      separatorBuilder: (_, __) =>
          Divider(height: 1, color: Colors.black.withOpacity(0.05)),
      itemBuilder: (context, i) {
        final label = '${cat['icon']} ${subs[i]}';
        final isSelected = selected.contains(label);
        final isDisabled = selected.length >= 3 && !isSelected;

        return GestureDetector(
          onTap: isDisabled ? null : () => onSelect(label),
          child: AnimatedOpacity(
            opacity: isDisabled ? 0.4 : 1.0,
            duration: const Duration(milliseconds: 150),
            child: Container(
              color: isSelected ? accent.withOpacity(0.05) : Colors.transparent,
              padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
              child: Row(
                children: [
                  Container(
                    width: 36,
                    height: 36,
                    decoration: BoxDecoration(
                      color: isSelected
                          ? accent.withOpacity(0.12)
                          : const Color(0xFFF2F2F7),
                      borderRadius: BorderRadius.circular(10),
                    ),
                    child: Center(
                      child: Text(
                        cat['icon'],
                        style: const TextStyle(fontSize: 18),
                      ),
                    ),
                  ),
                  const SizedBox(width: 14),
                  Expanded(
                    child: Text(
                      subs[i],
                      style: TextStyle(
                        fontSize: 15,
                        color: const Color(0xFF1C1C1E),
                        fontWeight: isSelected
                            ? FontWeight.w600
                            : FontWeight.normal,
                      ),
                    ),
                  ),
                  AnimatedContainer(
                    duration: const Duration(milliseconds: 200),
                    width: 24,
                    height: 24,
                    decoration: BoxDecoration(
                      gradient: isSelected
                          ? LinearGradient(
                              colors: gradColors,
                              begin: Alignment.topLeft,
                              end: Alignment.bottomRight,
                            )
                          : null,
                      color: isSelected ? null : const Color(0xFFF2F2F7),
                      shape: BoxShape.circle,
                      border: Border.all(
                        color: isSelected
                            ? Colors.transparent
                            : const Color(0xFFD1D1D6),
                        width: 1.5,
                      ),
                    ),
                    child: isSelected
                        ? const Icon(Icons.check, color: Colors.white, size: 14)
                        : null,
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }
}
