class _RegisterForm extends StatefulWidget {
  final Color accent;
  final List<Color> gradColors;
  final String role;
  final bool isMaster;
  const _RegisterForm({
    required this.accent,
    required this.gradColors,
    required this.role,
    required this.isMaster,
  });
  @override
  State<_RegisterForm> createState() => _RegisterFormState();
}

List<String> _specSelected = [];

class _RegisterFormState extends State<_RegisterForm> {
  final _name = TextEditingController();
  final _surname = TextEditingController();
  final _contact = TextEditingController(text: '+7 ');
  final _pass = TextEditingController();
  final _pass2 = TextEditingController();
  final _spec = TextEditingController();
  bool _isPhone = true,
      _obscure = true,
      _agree = false,
      _loading = false,
      _passMatch = true;

  @override
  void initState() {
    super.initState();
    _pass.addListener(_chk);
    _pass2.addListener(_chk);
  }

  void _chk() {
    final ok = _pass2.text.isEmpty || _pass.text == _pass2.text;
    if (ok != _passMatch) setState(() => _passMatch = ok);
  }

  void _toggle(bool phone) => setState(() {
    _isPhone = phone;
    _contact.text = phone ? '+7 ' : '';
  });

  void _onPhone(String v) {
    if (!_isPhone) return;
    final f = _formatPhone(v);
    _contact.value = TextEditingValue(
      text: f,
      selection: TextSelection.collapsed(offset: f.length),
    );
  }

  @override
  void dispose() {
    _name.dispose();
    _surname.dispose();
    _contact.dispose();
    _pass.dispose();
    _pass2.dispose();
    _spec.dispose();
    super.dispose();
  }

  void _submit() async {
    if (_name.text.isEmpty ||
        _surname.text.isEmpty ||
        _contact.text.trim().isEmpty ||
        _pass.text.isEmpty ||
        _pass2.text.isEmpty) {
      _err('Заполните все поля');
      return;
    }
    if (widget.isMaster && _specSelected.isEmpty) {
      _err('Выберите хотя бы одну специализацию');
      return;
    }
    if (_pass.text != _pass2.text) {
      _err('Пароли не совпадают');
      return;
    }
    if (!_agree) {
      _err('Примите условия использования');
      return;
    }
    setState(() => _loading = true);
    await Future.delayed(const Duration(seconds: 1));
    setState(() => _loading = false);
    if (mounted)
      showCupertinoDialog(
        context: context,
        builder: (_) => CupertinoAlertDialog(
          title: const Text('Аккаунт создан!'),
          content: Text(
            widget.isMaster ? 'Добро пожаловать, мастер!' : 'Добро пожаловать!',
          ),
          actions: [
            CupertinoDialogAction(
              child: const Text('OK'),
              onPressed: () {
                Navigator.pop(context);
                Navigator.pop(context);
              },
            ),
          ],
        ),
      );
  }

  void _err(String m) => showCupertinoDialog(
    context: context,
    builder: (_) => CupertinoAlertDialog(
      title: const Text('Ошибка'),
      content: Text(m),
      actions: [
        CupertinoDialogAction(
          child: const Text('OK'),
          onPressed: () => Navigator.pop(context),
        ),
      ],
    ),
  );

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        _TypeSwitch(
          isPhone: _isPhone,
          accent: widget.accent,
          onToggle: _toggle,
        ),
        const SizedBox(height: 20),
        _FlatField(
          label: 'Имя',
          controller: _name,
          hint: 'Иван',
          icon: CupertinoIcons.person,
          textCapitalization: TextCapitalization.words,
          accent: widget.accent,
        ),
        const SizedBox(height: 12),
        _FlatField(
          label: 'Фамилия',
          controller: _surname,
          hint: 'Иванов',
          icon: CupertinoIcons.person_2,
          textCapitalization: TextCapitalization.words,
          accent: widget.accent,
        ),
        const SizedBox(height: 12),
        _FlatField(
          label: _isPhone ? 'Номер телефона' : 'Email',
          controller: _contact,
          hint: _isPhone ? '+7 (___) ___-__-__' : 'example@mail.com',
          icon: _isPhone ? CupertinoIcons.phone : CupertinoIcons.mail,
          keyboardType: _isPhone
              ? TextInputType.phone
              : TextInputType.emailAddress,
          onChanged: _onPhone,
          accent: widget.accent,
        ),
        if (widget.isMaster) ...[
          const SizedBox(height: 12),
          _SpecPicker(
            accent: widget.accent,
            gradColors: widget.gradColors,
            selected: _specSelected,
            onChanged: (v) => setState(() {
              if (_specSelected.contains(v)) {
                _specSelected.remove(v);
              } else if (_specSelected.length < 3) {
                _specSelected.add(v);
              }
            }),
          ),
        ],
        const SizedBox(height: 12),
        _FlatField(
          label: 'Пароль',
          controller: _pass,
          hint: 'Минимум 6 символов',
          icon: CupertinoIcons.lock,
          obscure: _obscure,
          onToggleObscure: () => setState(() => _obscure = !_obscure),
          accent: widget.accent,
        ),
        const SizedBox(height: 12),
        _FlatField(
          label: 'Подтвердите пароль',
          controller: _pass2,
          hint: 'Повторите пароль',
          icon: CupertinoIcons.lock_fill,
          obscure: true,
          hasError: !_passMatch,
          accent: widget.accent,
        ),
        if (!_passMatch)
          Padding(
            padding: const EdgeInsets.only(top: 5),
            child: Row(
              children: const [
                Icon(
                  CupertinoIcons.exclamationmark_circle_fill,
                  color: Color(0xFFFF3B30),
                  size: 13,
                ),
                SizedBox(width: 5),
                Text(
                  'Пароли не совпадают',
                  style: TextStyle(fontSize: 12, color: Color(0xFFFF3B30)),
                ),
              ],
            ),
          ),
        const SizedBox(height: 16),
        GestureDetector(
          onTap: () => setState(() => _agree = !_agree),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              AnimatedContainer(
                duration: const Duration(milliseconds: 150),
                width: 22,
                height: 22,
                decoration: BoxDecoration(
                  gradient: _agree
                      ? LinearGradient(
                          colors: widget.gradColors,
                          begin: Alignment.topLeft,
                          end: Alignment.bottomRight,
                        )
                      : null,
                  color: _agree ? null : const Color(0xFFF2F2F7),
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(
                    color: _agree
                        ? Colors.transparent
                        : const Color(0xFFD1D1D6),
                    width: 1.5,
                  ),
                ),
                child: _agree
                    ? const Icon(Icons.check, color: Colors.white, size: 14)
                    : null,
              ),
              const SizedBox(width: 10),
              Expanded(
                child: RichText(
                  text: TextSpan(
                    style: const TextStyle(
                      fontSize: 13,
                      color: Color(0xFF8E8E93),
                    ),
                    children: [
                      const TextSpan(text: 'Я принимаю '),
                      TextSpan(
                        text: 'Условия использования',
                        style: TextStyle(
                          color: widget.accent,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                      const TextSpan(text: ' и '),
                      TextSpan(
                        text: 'Политику конфиденциальности',
                        style: TextStyle(
                          color: widget.accent,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 24),
        _BigButton(
          label: 'ЗАРЕГИСТРИРОВАТЬСЯ',
          gradColors: widget.gradColors,
          accent: widget.accent,
          loading: _loading,
          onTap: _submit,
        ),
        const SizedBox(height: 16),
        Center(
          child: RichText(
            text: TextSpan(
              style: const TextStyle(fontSize: 14),
              children: [
                const TextSpan(
                  text: 'Уже есть аккаунт?  ',
                  style: TextStyle(color: Color(0xFF8E8E93)),
                ),
                TextSpan(
                  text: 'Sign in',
                  style: TextStyle(
                    color: widget.accent,
                    fontWeight: FontWeight.w700,
                  ),
                ),
              ],
            ),
          ),
        ),
      ],
    );
  }
}

