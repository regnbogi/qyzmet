String findNearestCity(double lat, double lon) {
  String nearest = kazakhstanCities[0]['name'];
  double minDist = double.infinity;
  for (final c in kazakhstanCities) {
    final d = Geolocator.distanceBetween(lat, lon, c['lat'], c['lon']);
    if (d < minDist) {
      minDist = d;
      nearest = c['name'];
    }
  }
  return nearest;
}

