                  ),
                  child: _agree
                      ? const Icon(Icons.check, color: Colors.white, size: 14)
                      : null,
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: RichText(
                    text: TextSpan(
                      style: const TextStyle(
                        fontSize: 13,
                        color: Color(0xFF8E8E93),
                      ),
                      children: [
                        TextSpan(text: t('agree_text')),
                        TextSpan(
                          text: t('terms'),
                          style: TextStyle(
                            color: widget.accent,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                        TextSpan(text: t('and')),
                        TextSpan(
                          text: t('privacy'),
                          style: TextStyle(
                            color: widget.accent,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 24),
          _BigButton(
            label: t('btn_register'),
            gradColors: widget.gradColors,
            accent: widget.accent,
            loading: _loading,
            onTap: _submit,
          ),
          const SizedBox(height: 16),
          Center(
            child: RichText(
              text: TextSpan(
                style: const TextStyle(fontSize: 14),
                children: [
