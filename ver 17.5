/// Возвращает ключ ближайшего города (не строку, а ключ перевода)
String findNearestCityKey(double lat, double lon) {
  String nearestKey = kazakhstanCities[0]['key'];
  double minDist = double.infinity;
  for (final c in kazakhstanCities) {
    final d = Geolocator.distanceBetween(lat, lon, c['lat'], c['lon']);
    if (d < minDist) {
      minDist = d;
      nearestKey = c['key'];
    }
  }
  return nearestKey;
}

