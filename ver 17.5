// StatefulWidget
class _PasswordRule extends StatefulWidget {
  final String textKey; // ← новый, с 'textKey'
  final TextEditingController controller;
  final bool Function(String) check;
  const _PasswordRule({
    required this.textKey,
    required this.controller,
    required this.check,
  });

  @override
  State<_PasswordRule> createState() => _PasswordRuleState();
}

// State
class _PasswordRuleState extends State<_PasswordRule> {
  late VoidCallback _langListener;

  @override
  void initState() {
    super.initState();
    _langListener = () => setState(() {});
    widget.controller.addListener(() => setState(() {}));
    langNotifier.addListener(_langListener);
  }

  @override
  void dispose() {
    langNotifier.removeListener(_langListener);
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    // ← внутри класса
    final passed = widget.check(widget.controller.text);
    return Padding(
      padding: const EdgeInsets.only(top: 3),
      child: Row(
        children: [
          Icon(
            passed
                ? CupertinoIcons.checkmark_circle_fill
                : CupertinoIcons.circle,
            size: 13,
            color: passed ? const Color(0xFF34C759) : const Color(0xFFB8B8C0),
          ),
          const SizedBox(width: 5),
          Text(
            t(widget.textKey),
            style: TextStyle(
              fontSize: 12,
              color: passed ? const Color(0xFF34C759) : const Color(0xFF8E8E93),
              fontWeight: passed ? FontWeight.w600 : FontWeight.normal,
            ),
          ),
        ],
      ),
    );
  }
} // ← закрывающая скобка _PasswordRuleState

