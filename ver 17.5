                      child: Row(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          Icon(
                            CupertinoIcons.info_circle,
                            size: 16,
                            color: widget.accent,
                          ),
                          const SizedBox(width: 10),
                          Expanded(
                            child: Text(
                              isPhone
                                  ? t('reset_phone_hint')
                                  : t('reset_email_hint'),
