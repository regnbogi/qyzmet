// Клиент — чистый синий
const kBlue1 = Color(0xFF1565C0);
const kBlue2 = Color(0xFF1E88E5);

// Мастер — свежий зелёный
const kGreen1 = Color(0xFF2E7D32);
const kGreen2 = Color(0xFF43A047);

// Категории — без изменений (оставь как есть)
const kCatRepair = Color(0xFF1565C0);
const kCatTutors = Color(0xFF2E7D32);
const kCatBeauty = Color(0xFF6A1B9A);
const kCatFreelance = Color(0xFFE65100);
const kCatLegal = Color(0xFF0277BD);
const kCatSport = Color(0xFFC62828);
const kCatArtists = Color(0xFF00695C);
const kCatHome = Color(0xFF4E342E);
const kCatVet = Color(0xFF37474F);
const kCatAuto = Color(0xFF6A1B9A);
const kCatOther = Color(0xFF558B2F);

// Тёмная тема — чуть теплее и контрастнее
const kDarkBg = Color(0xFF0F0F14);
const kDarkCard = Color(0xFF1C1C24);
const kDarkDivider = Color(0xFF2A2A36);
const kDarkText = Color(0xFFF5F5FF);
const kDarkSubText = Color(0xFF8888AA);

// Используется везде вместо Colors.white / Color(0xFF1C1C1E) и т.д.
Color kCardBg() => darkNotifier.value ? kDarkCard : Colors.white;
Color kScaffoldBg() => darkNotifier.value ? kDarkBg : const Color(0xFFF7F8FC);
Color kPrimaryText() =>
    darkNotifier.value ? kDarkText : const Color(0xFF1A1A2E);
Color kSecondaryText() =>
    darkNotifier.value ? kDarkSubText : const Color(0xFF6B7280);
Color kDividerColor() =>
    darkNotifier.value ? kDarkDivider : const Color(0xFFE5E7EB);
Color kFieldBg() =>
    darkNotifier.value ? const Color(0xFF252530) : const Color(0xFFF3F4F6);

final ValueNotifier<String> langNotifier = ValueNotifier('RU');
final ValueNotifier<bool> darkNotifier = ValueNotifier(false);
final ValueNotifier<String> roleNotifier = ValueNotifier('client');
final ValueNotifier<List<Color>> gradientNotifier = ValueNotifier([
  kBlue1,
  kBlue2,
]);
final ValueNotifier<List<String>> masterSpecsNotifier = ValueNotifier([]);
final ValueNotifier<bool> isLoggedInNotifier = ValueNotifier(false);

void setRoleColors(String role) {
  if (role == 'master') {
    gradientNotifier.value = [kGreen1, kGreen2];
  } else {
    gradientNotifier.value = [kBlue1, kBlue2];
  }
}

