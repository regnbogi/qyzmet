// ГОРОД
// cityKey хранит ключ перевода (например 'city_almaty'),
// а не строку на конкретном языке.
// ─────────────────────────────────────────────
class CitySelectScreen extends StatefulWidget {
  final String role;
  const CitySelectScreen({super.key, required this.role});
  @override
  State<CitySelectScreen> createState() => _CitySelectScreenState();
}

class _CitySelectScreenState extends State<CitySelectScreen> {
  bool _loading = false;

  Future<void> _detect() async {
    setState(() => _loading = true);
    try {
      if (!await Geolocator.isLocationServiceEnabled()) {
        _err(t('geo_disabled'));
        setState(() => _loading = false);
        return;
      }
      LocationPermission p = await Geolocator.checkPermission();
      if (p == LocationPermission.denied) {
        p = await Geolocator.requestPermission();
        if (p == LocationPermission.denied) {
          _err(t('geo_denied'));
          setState(() => _loading = false);
          return;
        }
      }
      if (p == LocationPermission.deniedForever) {
        _err(t('geo_blocked'));
        setState(() => _loading = false);
        return;
      }
      final pos = await Geolocator.getCurrentPosition();
      // Получаем ключ перевода, а не строку
      final cityKey = findNearestCityKey(pos.latitude, pos.longitude);
      if (mounted) {
        Navigator.pushReplacement(
          context,
          CupertinoPageRoute(
            builder: (_) => HomeScreen(cityKey: cityKey, role: widget.role),
          ),
        );
      }
    } catch (_) {
      _err(t('geo_error'));
      setState(() => _loading = false);
    }
  }

  void _err(String m) => showCupertinoDialog(
    context: context,
    builder: (_) => CupertinoAlertDialog(
      title: Text(t('error')),
      content: Text(m),
      actions: [
        CupertinoDialogAction(
          child: Text(t('ok')),
          onPressed: () => Navigator.pop(context),
        ),
      ],
    ),
  );

  void _go(String cityKey) => Navigator.pushReplacement(
    context,
    CupertinoPageRoute(
      builder: (_) => HomeScreen(cityKey: cityKey, role: widget.role),
    ),
  );

  @override
  Widget build(BuildContext context) {
    return _AppShell(
      grad: const [kBlue1, kBlue2],
      headerBuilder: (lang) => Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            t('your_city'),
            style: const TextStyle(
              fontSize: 34,
              fontWeight: FontWeight.w800,
              color: Colors.white,
              letterSpacing: -0.5,
              height: 1.1,
            ),
          ),
          const SizedBox(height: 4),
          Text(
            t('city_subtitle'),
            style: const TextStyle(fontSize: 15, color: Colors.white70),
          ),
        ],
      ),
      // cardBuilder реагирует на lang — список городов перерисуется при смене языка
      cardBuilder: (lang) => Column(
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(24, 20, 24, 16),
            child: GestureDetector(
              onTap: _loading ? null : _detect,
              child: Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 20,
                  vertical: 15,
                ),
                decoration: BoxDecoration(
                  gradient: const LinearGradient(
                    colors: [kBlue1, kBlue2],
                    begin: Alignment.topLeft,
                    end: Alignment.bottomRight,
                  ),
                  borderRadius: BorderRadius.circular(30),
                  boxShadow: [
                    BoxShadow(
                      color: kBlue2.withOpacity(0.4),
                      blurRadius: 14,
                      offset: const Offset(0, 6),
                    ),
                  ],
                ),
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.center,
                  children: [
                    if (_loading)
                      const CupertinoActivityIndicator(color: Colors.white)
                    else
                      const Icon(
                        CupertinoIcons.location_fill,
                        color: Colors.white,
                        size: 18,
                      ),
                    const SizedBox(width: 10),
                    Text(
                      _loading ? t('detecting') : t('detect_location'),
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 15,
                        fontWeight: FontWeight.w700,
                      ),
                    ),
                  ],
                ),
              ),
            ),
          ),
          Padding(
            padding: const EdgeInsets.fromLTRB(24, 0, 24, 10),
            child: Text(
              t('or_choose_city'),
              style: TextStyle(
                fontSize: 13,
                fontWeight: FontWeight.w600,
                color: darkNotifier.value
                    ? kDarkSubText
                    : Colors.black.withOpacity(0.35),
              ),
            ),
          ),
          Expanded(
            child: ListView.separated(
              padding: EdgeInsets.zero,
              itemCount: kazakhstanCities.length,
              separatorBuilder: (_, _) =>
                  Divider(height: 1, color: Colors.black.withOpacity(0.06)),
              itemBuilder: (context, i) {
                final cityKey = kazakhstanCities[i]['key'] as String;
                // t(cityKey) возвращает название на текущем языке
                final cityName = t(cityKey);
                return GestureDetector(
                  onTap: () => _go(cityKey),
