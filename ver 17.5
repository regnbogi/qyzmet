                          Expanded(
                            child: TextField(
                              controller: resetContact,
                              keyboardType: isPhone
                                  ? TextInputType.phone
                                  : TextInputType.emailAddress,
                              autofocus: true,
                              onChanged: (v) {
                                if (!isPhone) return;
                                final f = _formatPhone(v);
                                setModalState(() {
                                  resetContact.value = TextEditingValue(
                                    text: f,
                                    selection: TextSelection.collapsed(
                                      offset: f.length,
                                    ),
                                  );
                                });
                              },
                              style: const TextStyle(
                                fontSize: 15,
                                color: Color(0xFF1C1C1E),
                              ),
                              decoration: InputDecoration(
                                hintText: isPhone
                                    ? '+7 (___) ___-__-__'
                                    : 'example@mail.com',
                                hintStyle: const TextStyle(
                                  color: Color(0xFFB8B8C0),
                                  fontSize: 15,
                                ),
                                border: InputBorder.none,
                                isDense: true,
                                contentPadding: const EdgeInsets.symmetric(
                                  vertical: 10,
                                ),
                              ),
                            ),
                          ),
                        ],
                      ),
                    ),
                    const SizedBox(height: 24),
                    _BigButton(
                      label: isPhone ? t('send_sms') : t('send_email'),
                      gradColors: widget.gradColors,
                      accent: widget.accent,
                      loading: false,
                      onTap: () {
                        final val = resetContact.text.trim();
                        if (val.isEmpty || (isPhone && val.length < 18)) return;
                        Navigator.pop(ctx);
                        showCupertinoDialog(
                          context: context,
                          builder: (_) => CupertinoAlertDialog(
                            title: Text(
                              isPhone ? t('sms_sent') : t('email_sent'),
                            ),
                            content: Text(
                              isPhone
                                  ? '${t('code_sent_to')}$val'
                                  : '${t('instruction_sent_to')}$val',
                            ),
                            actions: [
                              CupertinoDialogAction(
                                child: Text(t('ok')),
                                onPressed: () => Navigator.pop(context),
                              ),
                            ],
                          ),
                        );
                      },
                    ),
                  ],
                ),
              ),
            ),
          ),
        ),
      ),
    );
  }

  void _submit() async {
    if (_contact.text.trim().isEmpty || _pass.text.isEmpty) {
      _err(t('fill_all'));
      return;
    }
    setState(() => _loading = true);
    await Future.delayed(const Duration(seconds: 1));
    setState(() => _loading = false);
    if (mounted) {
      showCupertinoDialog(
        context: context,
        builder: (_) => CupertinoAlertDialog(
          title: Text(t('success')),
          content: Text(t('logged_in')),
          actions: [
            CupertinoDialogAction(
              child: Text(t('ok')),
              onPressed: () {
                Navigator.pop(context);
                Navigator.pop(context);
              },
            ),
          ],
        ),
      );
    }
  }

  void _err(String m) => showCupertinoDialog(
    context: context,
    builder: (_) => CupertinoAlertDialog(
      title: Text(t('error')),
      content: Text(m),
      actions: [
        CupertinoDialogAction(
          child: Text(t('ok')),
          onPressed: () => Navigator.pop(context),
        ),
      ],
    ),
  );

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<String>(
      valueListenable: langNotifier,
      builder: (_, lang, _) => Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _TypeSwitch(
            isPhone: _isPhone,
            accent: widget.accent,
            onToggle: _toggle,
