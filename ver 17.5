class _SubcategoryList extends StatelessWidget {
  final String categoryTitleKey;
  final Color accent;
  final List<Color> gradColors;
  final List<String> selected; // ключи выбранных подкатегорий
  final ValueChanged<String> onSelect;
  const _SubcategoryList({
    required this.categoryTitleKey,
    required this.accent,
    required this.gradColors,
    required this.selected,
    required this.onSelect,
  });

  @override
  Widget build(BuildContext context) {
    final cat = categoryData.firstWhere(
      (c) => c['titleKey'] == categoryTitleKey,
    );
    final subKeys = List<String>.from(cat['subcategoryKeys']);
    final icon = cat['icon'] as IconData;

    return ValueListenableBuilder<String>(
      valueListenable: langNotifier,
      builder: (_, lang, _) => ListView.separated(
        padding: EdgeInsets.zero,
        itemCount: subKeys.length,
        separatorBuilder: (_, _) =>
            Divider(height: 1, color: Colors.black.withOpacity(0.05)),
        itemBuilder: (context, i) {
          final key = subKeys[i];
          final isSelected = selected.contains(key);
          final isDisabled = selected.length >= 3 && !isSelected;
          return GestureDetector(
            onTap: isDisabled ? null : () => onSelect(key),
            child: AnimatedOpacity(
              opacity: isDisabled ? 0.4 : 1.0,
              duration: const Duration(milliseconds: 150),
              child: Container(
                color: isSelected
                    ? accent.withOpacity(0.05)
                    : Colors.transparent,
                padding: const EdgeInsets.symmetric(
                  horizontal: 24,
                  vertical: 14,
                ),
                child: Row(
                  children: [
                    Container(
                      width: 36,
                      height: 36,
                      decoration: BoxDecoration(
                        color: isSelected
                            ? accent.withOpacity(0.12)
                            : const Color(0xFFF2F2F7),
                        borderRadius: BorderRadius.circular(10),
                      ),
                      child: Center(
                        child: Icon(
                          icon,
                          size: 18,
                          color: const Color(0xFF555555),
                        ),
                      ),
                    ),
                    const SizedBox(width: 14),
                    Expanded(
                      child: Text(
                        t(key), // ← переводим ключ в текущий язык
                        style: TextStyle(
                          fontSize: 15,
                          color: darkNotifier.value
                              ? kDarkText
                              : const Color(0xFF1C1C1E),

                          fontWeight: isSelected
                              ? FontWeight.w600
                              : FontWeight.normal,
                        ),
                      ),
                    ),
                    AnimatedContainer(
                      duration: const Duration(milliseconds: 200),
                      width: 24,
                      height: 24,
                      decoration: BoxDecoration(
                        gradient: isSelected
                            ? LinearGradient(
                                colors: gradColors,
                                begin: Alignment.topLeft,
                                end: Alignment.bottomRight,
                              )
                            : null,
                        color: isSelected ? null : const Color(0xFFF2F2F7),
                        shape: BoxShape.circle,
                        border: Border.all(
                          color: isSelected
                              ? Colors.transparent
                              : const Color(0xFFD1D1D6),
                          width: 1.5,
                        ),
                      ),
                      child: isSelected
                          ? const Icon(
                              Icons.check,
                              color: Colors.white,
                              size: 14,
                            )
                          : null,
                    ),
                  ],
                ),
              ),
            ),
          );
        },
      ),
    );
  }
}

