class MasterFinderScreen extends StatefulWidget {
  const MasterFinderScreen({super.key});
  @override
  State<MasterFinderScreen> createState() => _MasterFinderScreenState();
}

class _MasterFinderScreenState extends State<MasterFinderScreen> {
  int _step = 0;
  String? _selectedCategory;
  String? _selectedSubcategory;
  List<String> _selectedProblems = [];
  String _otherProblem = '';
  String? _selectedWhere;
  String? _selectedWhen;
  final _addressCtrl = TextEditingController();

  @override
  void dispose() {
    _addressCtrl.dispose();
    super.dispose();
  }

  String _stepTitle() {
    switch (_step) {
      case 0:
        return 'В какой сфере\nищете мастера?';
      case 1:
        return 'Выберите\nспециализацию';
      case 2:
        return 'Что нужно\nсделать?';
      case 3:
        return 'Где и когда\nнужен мастер?';
      case 4:
        return 'Укажите\nадрес';
      default:
        return '';
    }
  }

  bool _canProceed() {
    switch (_step) {
      case 0:
        return _selectedCategory != null;
      case 1:
        return _selectedSubcategory != null;
      case 2:
        return _selectedProblems.isNotEmpty || _otherProblem.isNotEmpty;
      case 3:
        return _selectedWhere != null && _selectedWhen != null;
      case 4:
        return _addressCtrl.text.trim().length > 3;
      default:
        return false;
    }
  }

  void _next() {
    if (_step < 4) {
      setState(() => _step++);
    } else {
      final cat = categoryData.firstWhere(
        (c) => c['titleKey'] == _selectedCategory,
      );
      Navigator.pushReplacement(
        context,
        CupertinoPageRoute(
          builder: (_) => MastersScreen(
            categoryTitleKey: _selectedCategory!,
            subcategoryKey: _selectedSubcategory!,
            icon: cat['icon'] as IconData,
            cityKey: 'city_almaty',
          ),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return _AppShell(
      grad: gradientNotifier.value,
      showBack: true,
      headerBuilder: (lang) => Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            _stepTitle(),
            style: const TextStyle(
              fontSize: 26,
              fontWeight: FontWeight.w800,
              color: Colors.white,
              letterSpacing: -0.5,
              height: 1.2,
            ),
          ),
          const SizedBox(height: 12),
          Row(
            children: List.generate(
              5,
              (i) => Expanded(
                child: Container(
                  margin: const EdgeInsets.only(right: 4),
                  height: 4,
                  decoration: BoxDecoration(
                    color: i < _step
                        ? Colors.white
                        : (i == _step
                              ? Colors.white.withOpacity(0.6)
                              : Colors.white.withOpacity(0.25)),
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
              ),
            ),
          ),
          const SizedBox(height: 6),
          Text(
            'Шаг ${_step + 1} из 5',
            style: const TextStyle(fontSize: 13, color: Colors.white70),
          ),
        ],
      ),
      cardBuilder: (lang) => Column(
        children: [
          Expanded(child: _buildStep()),
          Padding(
            padding: const EdgeInsets.fromLTRB(20, 0, 20, 24),
            child: _canProceed()
                ? _BigButton(
                    label: _step == 4 ? '🔍 Найти мастеров' : 'Далее →',
                    gradColors: gradientNotifier.value,
                    accent: gradientNotifier.value[1],
                    loading: false,
                    onTap: _next,
                  )
                : Container(
                    width: double.infinity,
                    padding: const EdgeInsets.symmetric(vertical: 16),
                    decoration: BoxDecoration(
                      color: Colors.grey.withOpacity(0.15),
                      borderRadius: BorderRadius.circular(30),
                    ),
                    child: const Center(
                      child: Text(
                        'Выберите вариант',
                        style: TextStyle(
                          color: Colors.grey,
                          fontSize: 15,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ),
                  ),
          ),
        ],
      ),
    );
  }

  Widget _buildStep() {
    switch (_step) {
      case 0:
        return _buildCategories();
      case 1:
        return _buildSubcategories();
      case 2:
        return _buildProblems();
      case 3:
        return _buildWhenWhere();
      case 4:
        return _buildAddress();
      default:
        return const SizedBox();
    }
  }

  Widget _buildCategories() {
    return ListView.builder(
      padding: const EdgeInsets.fromLTRB(20, 16, 20, 8),
      itemCount: categoryData.length,
      itemBuilder: (context, i) {
        final cat = categoryData[i];
        final key = cat['titleKey'] as String;
        final selected = _selectedCategory == key;
        return GestureDetector(
          onTap: () => setState(() {
            _selectedCategory = key;
            _selectedSubcategory = null;
            _selectedProblems = [];
          }),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 150),
            margin: const EdgeInsets.only(bottom: 10),
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
            decoration: BoxDecoration(
              color: selected
                  ? gradientNotifier.value[0].withOpacity(0.1)
                  : (darkNotifier.value ? kDarkCard : const Color(0xFFF7F8FA)),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(
                color: selected
                    ? gradientNotifier.value[0]
                    : Colors.transparent,
                width: 2,
              ),
            ),
            child: Row(
              children: [
                Container(
                  width: 42,
                  height: 42,
                  decoration: BoxDecoration(
                    color: cat['color'] as Color,
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Icon(
                    cat['icon'] as IconData,
                    color: Colors.white,
                    size: 22,
                  ),
                ),
                const SizedBox(width: 14),
                Expanded(
                  child: Text(
                    t(key),
                    style: TextStyle(
                      fontSize: 15,
                      fontWeight: selected ? FontWeight.w700 : FontWeight.w500,
                      color: darkNotifier.value
                          ? kDarkText
                          : const Color(0xFF1C1C1E),
                    ),
                  ),
                ),
                if (selected)
                  Icon(
                    CupertinoIcons.checkmark_circle_fill,
                    color: gradientNotifier.value[0],
                    size: 22,
                  ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _buildSubcategories() {
    final cat = categoryData.firstWhere(
      (c) => c['titleKey'] == _selectedCategory,
    );
    final subKeys = List<String>.from(cat['subcategoryKeys']);
    return ListView.builder(
      padding: const EdgeInsets.fromLTRB(20, 16, 20, 8),
      itemCount: subKeys.length,
      itemBuilder: (context, i) {
        final key = subKeys[i];
        final selected = _selectedSubcategory == key;
        return GestureDetector(
          onTap: () => setState(() {
            _selectedSubcategory = key;
            _selectedProblems = [];
          }),
          child: AnimatedContainer(
            duration: const Duration(milliseconds: 150),
            margin: const EdgeInsets.only(bottom: 10),
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
            decoration: BoxDecoration(
              color: selected
                  ? gradientNotifier.value[0].withOpacity(0.1)
                  : (darkNotifier.value ? kDarkCard : const Color(0xFFF7F8FA)),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(
                color: selected
                    ? gradientNotifier.value[0]
                    : Colors.transparent,
                width: 2,
              ),
            ),
            child: Row(
              children: [
                Icon(
                  cat['icon'] as IconData,
                  size: 22,
                  color: selected
                      ? gradientNotifier.value[0]
                      : const Color(0xFF8E8E93),
                ),
                const SizedBox(width: 14),
                Expanded(
                  child: Text(
                    t(key),
                    style: TextStyle(
                      fontSize: 15,
                      fontWeight: selected ? FontWeight.w700 : FontWeight.w500,
                      color: darkNotifier.value
                          ? kDarkText
                          : const Color(0xFF1C1C1E),
                    ),
                  ),
                ),
                if (selected)
                  Icon(
                    CupertinoIcons.checkmark_circle_fill,
                    color: gradientNotifier.value[0],
                    size: 22,
                  ),
              ],
            ),
          ),
        );
      },
    );
  }

  Widget _buildProblems() {
    final problems = wizardData[_selectedCategory]?[_selectedSubcategory] ?? [];
    return ListView(
      padding: const EdgeInsets.fromLTRB(20, 16, 20, 8),
      children: [
        ...problems.map((problem) {
          final selected = _selectedProblems.contains(problem);
          return GestureDetector(
            onTap: () => setState(() {
              selected
                  ? _selectedProblems.remove(problem)
                  : _selectedProblems.add(problem);
            }),
            child: AnimatedContainer(
              duration: const Duration(milliseconds: 150),
              margin: const EdgeInsets.only(bottom: 10),
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 14),
              decoration: BoxDecoration(
                color: selected
                    ? gradientNotifier.value[0].withOpacity(0.1)
                    : (darkNotifier.value
                          ? kDarkCard
                          : const Color(0xFFF7F8FA)),
                borderRadius: BorderRadius.circular(14),
                border: Border.all(
                  color: selected
                      ? gradientNotifier.value[0]
                      : Colors.transparent,
                  width: 2,
                ),
              ),
              child: Row(
                children: [
                  AnimatedContainer(
                    duration: const Duration(milliseconds: 150),
                    width: 24,
                    height: 24,
                    decoration: BoxDecoration(
                      color: selected
                          ? gradientNotifier.value[0]
                          : Colors.transparent,
                      borderRadius: BorderRadius.circular(6),
                      border: Border.all(
                        color: selected
                            ? gradientNotifier.value[0]
                            : const Color(0xFFD1D1D6),
                        width: 2,
                      ),
                    ),
                    child: selected
                        ? const Icon(Icons.check, color: Colors.white, size: 14)
                        : null,
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: Text(
                      problem,
                      style: TextStyle(
                        fontSize: 15,
                        fontWeight: selected
                            ? FontWeight.w600
                            : FontWeight.normal,
                        color: darkNotifier.value
                            ? kDarkText
                            : const Color(0xFF1C1C1E),
                      ),
                    ),
                  ),
                ],
              ),
            ),
          );
        }),
        const SizedBox(height: 4),
        // Поле "Другое"
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          decoration: BoxDecoration(
            color: _otherProblem.isNotEmpty
                ? gradientNotifier.value[0].withOpacity(0.1)
                : (darkNotifier.value ? kDarkCard : const Color(0xFFF7F8FA)),
            borderRadius: BorderRadius.circular(14),
            border: Border.all(
              color: _otherProblem.isNotEmpty
                  ? gradientNotifier.value[0]
                  : Colors.transparent,
              width: 2,
            ),
          ),
          child: Row(
            children: [
              AnimatedContainer(
                duration: const Duration(milliseconds: 150),
                width: 24,
                height: 24,
                decoration: BoxDecoration(
                  color: _otherProblem.isNotEmpty
                      ? gradientNotifier.value[0]
                      : Colors.transparent,
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(
                    color: _otherProblem.isNotEmpty
