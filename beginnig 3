// ── Форма регистрации ─────────────────────────
class _RegisterForm extends StatefulWidget {
  final Color accent;
  final List<Color> gradColors;
  final String role;
  final bool isMaster;
  const _RegisterForm({
    required this.accent,
    required this.gradColors,
    required this.role,
    required this.isMaster,
  });
  @override
  State<_RegisterForm> createState() => _RegisterFormState();
}

class _RegisterFormState extends State<_RegisterForm> {
  final _name = TextEditingController();
  final _surname = TextEditingController();
  final _phone = TextEditingController(text: '+7 ');
  final _pass = TextEditingController();
  final _pass2 = TextEditingController();
  final _spec = TextEditingController();
  bool _obscure = true;
  bool _loading = false;
  bool _agree = false;
  bool _passMatch = true;

  @override
  void initState() {
    super.initState();
    _pass.addListener(_checkPasswords);
    _pass2.addListener(_checkPasswords);
  }

  void _checkPasswords() {
    final match = _pass2.text.isEmpty || _pass.text == _pass2.text;
    if (match != _passMatch) setState(() => _passMatch = match);
  }

  @override
  void dispose() {
    _name.dispose();
    _surname.dispose();
    _phone.dispose();
    _pass.dispose();
    _pass2.dispose();
    _spec.dispose();
    super.dispose();
  }

  void _onPhoneChanged(String val) {
    final formatted = _formatPhoneNumber(val);
    _phone.value = TextEditingValue(
      text: formatted,
      selection: TextSelection.collapsed(offset: formatted.length),
    );
  }

  void _submit() async {
    if (_name.text.isEmpty ||
        _surname.text.isEmpty ||
        _phone.text.length < 18 ||
        _pass.text.isEmpty ||
        _pass2.text.isEmpty) {
      _showErr('Заполните все поля');
      return;
    }
    if (_pass.text != _pass2.text) {
      _showErr('Пароли не совпадают');
      return;
    }
    if (!_agree) {
      _showErr('Примите условия использования');
      return;
    }
    setState(() => _loading = true);
    await Future.delayed(const Duration(seconds: 1));
    setState(() => _loading = false);
    if (mounted) {
      showCupertinoDialog(
        context: context,
        builder: (_) => CupertinoAlertDialog(
          title: const Text('Аккаунт создан!'),
          content: Text(
            widget.isMaster ? 'Добро пожаловать, мастер!' : 'Добро пожаловать!',
          ),
          actions: [
            CupertinoDialogAction(
              child: const Text('OK'),
              onPressed: () {
                Navigator.pop(context);
                Navigator.pop(context);
              },
            ),
          ],
        ),
      );
    }
  }

  void _showErr(String m) => showCupertinoDialog(
    context: context,
    builder: (_) => CupertinoAlertDialog(
      title: const Text('Ошибка'),
      content: Text(m),
      actions: [
        CupertinoDialogAction(
          child: const Text('OK'),
          onPressed: () => Navigator.pop(context),
        ),
      ],
    ),
  );

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        _FieldLabel('Имя'),
        const SizedBox(height: 6),
        _Glass(
          radius: 14,
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          child: TextField(
            controller: _name,
            textCapitalization: TextCapitalization.words,
            decoration: const InputDecoration(
              hintText: 'Иван',
              hintStyle: TextStyle(color: Color(0xFFB0B0B8)),
              border: InputBorder.none,
              prefixIcon: Icon(
                CupertinoIcons.person,
                color: Color(0xFF8E8E93),
                size: 18,
              ),
            ),
          ),
        ),
        const SizedBox(height: 14),

        _FieldLabel('Фамилия'),
        const SizedBox(height: 6),
        _Glass(
          radius: 14,
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          child: TextField(
            controller: _surname,
            textCapitalization: TextCapitalization.words,
            decoration: const InputDecoration(
              hintText: 'Иванов',
              hintStyle: TextStyle(color: Color(0xFFB0B0B8)),
              border: InputBorder.none,
              prefixIcon: Icon(
                CupertinoIcons.person_2,
                color: Color(0xFF8E8E93),
                size: 18,
              ),
            ),
          ),
        ),
        const SizedBox(height: 14),

        _FieldLabel('Номер телефона'),
        const SizedBox(height: 6),
        _Glass(
          radius: 14,
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          child: TextField(
            controller: _phone,
            keyboardType: TextInputType.phone,
            onChanged: _onPhoneChanged,
            decoration: const InputDecoration(
              hintText: '+7 (___) ___-__-__',
              hintStyle: TextStyle(color: Color(0xFFB0B0B8)),
              border: InputBorder.none,
              prefixIcon: Icon(
                CupertinoIcons.phone,
                color: Color(0xFF8E8E93),
                size: 18,
              ),
            ),
          ),
        ),

        if (widget.isMaster) ...[
          const SizedBox(height: 14),
          _FieldLabel('Специализация'),
          const SizedBox(height: 6),
          _Glass(
            radius: 14,
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
            child: TextField(
              controller: _spec,
              decoration: const InputDecoration(
                hintText: 'Например: Сантехник, Электрик...',
                hintStyle: TextStyle(color: Color(0xFFB0B0B8)),
                border: InputBorder.none,
                prefixIcon: Icon(
                  CupertinoIcons.hammer,
                  color: Color(0xFF8E8E93),
                  size: 18,
                ),
              ),
            ),
          ),
        ],

        const SizedBox(height: 14),
        _FieldLabel('Пароль'),
        const SizedBox(height: 6),
        _Glass(
          radius: 14,
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          child: TextField(
            controller: _pass,
            obscureText: _obscure,
            decoration: InputDecoration(
              hintText: 'Минимум 6 символов',
              hintStyle: const TextStyle(color: Color(0xFFB0B0B8)),
              border: InputBorder.none,
              prefixIcon: const Icon(
                CupertinoIcons.lock,
                color: Color(0xFF8E8E93),
                size: 18,
              ),
              suffixIcon: GestureDetector(
                onTap: () => setState(() => _obscure = !_obscure),
                child: Icon(
                  _obscure ? CupertinoIcons.eye : CupertinoIcons.eye_slash,
                  color: const Color(0xFF8E8E93),
                  size: 18,
                ),
              ),
            ),
          ),
        ),
        const SizedBox(height: 14),
        _FieldLabel('Подтвердите пароль'),
        const SizedBox(height: 6),
        _Glass(
          radius: 14,
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
          tint: !_passMatch ? const Color(0xFFFFEEEE) : Colors.white,
          child: TextField(
            controller: _pass2,
            obscureText: true,
            decoration: const InputDecoration(
              hintText: 'Повторите пароль',
              hintStyle: TextStyle(color: Color(0xFFB0B0B8)),
              border: InputBorder.none,
              prefixIcon: Icon(
                CupertinoIcons.lock_fill,
                color: Color(0xFF8E8E93),
                size: 18,
              ),
            ),
          ),
        ),

        // Ошибка несовпадения паролей
        AnimatedSwitcher(
          duration: const Duration(milliseconds: 200),
          child: !_passMatch
              ? Padding(
                  key: const ValueKey('mismatch'),
                  padding: const EdgeInsets.only(top: 6),
                  child: Row(
                    children: const [
                      Icon(
                        CupertinoIcons.exclamationmark_circle_fill,
                        color: Color(0xFFFF3B30),
                        size: 14,
                      ),
                      SizedBox(width: 5),
                      Text(
                        'Пароли не совпадают',
                        style: TextStyle(
                          fontSize: 13,
                          color: Color(0xFFFF3B30),
                          fontWeight: FontWeight.w500,
                        ),
                      ),
                    ],
                  ),
                )
              : const SizedBox.shrink(key: ValueKey('ok')),
        ),

        const SizedBox(height: 16),

        GestureDetector(
          onTap: () => setState(() => _agree = !_agree),
          child: Row(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              AnimatedContainer(
                duration: const Duration(milliseconds: 150),
                width: 22,
                height: 22,
                decoration: BoxDecoration(
                  gradient: _agree
                      ? LinearGradient(
                          colors: widget.gradColors,
                          begin: Alignment.topLeft,
                          end: Alignment.bottomRight,
                        )
                      : null,
                  color: _agree ? null : Colors.white,
                  borderRadius: BorderRadius.circular(6),
                  border: Border.all(
                    color: _agree
                        ? Colors.transparent
                        : const Color(0xFFD1D1D6),
                    width: 1.5,
                  ),
                ),
                child: _agree
                    ? const Icon(Icons.check, color: Colors.white, size: 14)
                    : null,
              ),
              const SizedBox(width: 10),
              Expanded(
                child: RichText(
                  text: TextSpan(
                    style: const TextStyle(
                      fontSize: 13,
                      color: Color(0xFF8E8E93),
                    ),
                    children: [
                      const TextSpan(text: 'Я принимаю '),
                      TextSpan(
                        text: 'Условия использования',
                        style: TextStyle(
                          color: widget.accent,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                      const TextSpan(text: ' и '),
                      TextSpan(
                        text: 'Политику конфиденциальности',
                        style: TextStyle(
                          color: widget.accent,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ],
                  ),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 24),
        _GradButton(
          label: _loading ? '...' : 'Создать аккаунт',
          gradColors: widget.gradColors,
          accent: widget.accent,
          onTap: _loading ? null : _submit,
        ),
      ],
    );
  }
}

