String findNearestCity(double lat, double lon) {
  String nearest = kazakhstanCities[0]['name'];
  double minDist = double.infinity;
  for (final city in kazakhstanCities) {
    final dist = Geolocator.distanceBetween(lat, lon, city['lat'], city['lon']);
    if (dist < minDist) {
      minDist = dist;
      nearest = city['name'];
    }
  }
  return nearest;
}

