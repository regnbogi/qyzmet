class _RegisterForm extends StatefulWidget {
  final Color accent;
  final List<Color> gradColors;
  final String role;
  final bool isMaster;
  const _RegisterForm({
    required this.accent,
    required this.gradColors,
    required this.role,
    required this.isMaster,
  });
  @override
  State<_RegisterForm> createState() => _RegisterFormState();
}

List<String> _specSelected = [];

class _RegisterFormState extends State<_RegisterForm> {
  final _name = TextEditingController();
  final _surname = TextEditingController();
  final _contact = TextEditingController(text: '+7 ');
  final _pass = TextEditingController();
  final _pass2 = TextEditingController();
  bool _isPhone = true,
      _obscure = true,
      _agree = false,
      _loading = false,
      _passMatch = true;

  @override
  void initState() {
    super.initState();
    _pass.addListener(_chk);
    _pass2.addListener(_chk);
  }

  void _chk() {
    final ok = _pass2.text.isEmpty || _pass.text == _pass2.text;
    if (ok != _passMatch) setState(() => _passMatch = ok);
  }

  void _toggle(bool phone) => setState(() {
    _isPhone = phone;
    _contact.text = phone ? '+7 ' : '@gmail.com';
  });
  void _onPhone(String v) {
    if (!_isPhone) return;
    final f = _formatPhone(v);
    _contact.value = TextEditingValue(
      text: f,
      selection: TextSelection.collapsed(offset: f.length),
    );
  }

  void _onEmail(String v) {
    if (_isPhone) return;
    // Если пользователь удалил @, восстанавливаем
    if (!v.contains('@')) {
      final f = '$v@gmail.com';
      _contact.value = TextEditingValue(
        text: f,
        selection: TextSelection.collapsed(offset: v.length),
      );
      return;
    }
    // Курсор держим перед @, если пользователь не трогал домен
    // Просто оставляем как есть
  }

  @override
  void dispose() {
    _name.dispose();
    _surname.dispose();
    _contact.dispose();
    _pass.dispose();
    _pass2.dispose();
    super.dispose();
  }

  void _submit() async {
    if (_name.text.isEmpty ||
        _surname.text.isEmpty ||
        _contact.text.trim().isEmpty ||
        _pass.text.isEmpty ||
        _pass2.text.isEmpty) {
      _err(t('fill_all'));
      return;
    }
    if (widget.isMaster && _specSelected.isEmpty) {
      _err(t('choose_spec'));
      return;
    }
    if (_pass.text != _pass2.text) {
      _err(t('passwords_no_match'));
      return;
    }
    if (!_agree) {
      _err(t('accept_terms'));
      return;
    }
    setState(() => _loading = true);
    await Future.delayed(const Duration(seconds: 1));
    if (widget.isMaster) {
      masterSpecsNotifier.value = List.from(_specSelected);
      isLoggedInNotifier.value = true;
    }
    setState(() => _loading = false);
    if (mounted) {
      showCupertinoDialog(
        context: context,
        builder: (_) => CupertinoAlertDialog(
          title: Text(t('account_created')),
          content: Text(widget.isMaster ? t('welcome_master') : t('welcome')),
          actions: [
            CupertinoDialogAction(
              child: Text(t('ok')),
              onPressed: () {
                Navigator.pop(context);
                Navigator.pop(context);
              },
            ),
          ],
        ),
      );
    }
  }

  void _err(String m) => showCupertinoDialog(
    context: context,
    builder: (_) => CupertinoAlertDialog(
      title: Text(t('error')),
      content: Text(m),
      actions: [
        CupertinoDialogAction(
          child: Text(t('ok')),
          onPressed: () => Navigator.pop(context),
        ),
      ],
    ),
  );

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<String>(
      valueListenable: langNotifier,
      builder: (_, lang, _) => Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          _TypeSwitch(
            isPhone: _isPhone,
            accent: widget.accent,
            onToggle: _toggle,
          ),
          const SizedBox(height: 20),
          _FlatField(
            label: t('first_name'),
            controller: _name,
            hint: t('first_name_hint'),
            icon: CupertinoIcons.person,
            textCapitalization: TextCapitalization.words,
            accent: widget.accent,
          ),
          const SizedBox(height: 12),
          _FlatField(
            label: t('last_name'),
            controller: _surname,
            hint: t('last_name_hint'),
            icon: CupertinoIcons.person_2,
            textCapitalization: TextCapitalization.words,
            accent: widget.accent,
          ),
          const SizedBox(height: 12),
          _FlatField(
            label: _isPhone ? t('phone') : t('email'),
            controller: _contact,
            hint: _isPhone ? '+7 (___) ___-__-__' : 'example@mail.com',
            icon: _isPhone ? CupertinoIcons.phone : CupertinoIcons.mail,
            keyboardType: _isPhone
                ? TextInputType.phone
                : TextInputType.emailAddress,
            onChanged: _onPhone,
            accent: widget.accent,
          ),
          if (widget.isMaster) ...[
            const SizedBox(height: 12),
            _SpecPicker(
              accent: widget.accent,
              gradColors: widget.gradColors,
              selected: _specSelected,
              onChanged: (v) => setState(() {
                if (_specSelected.contains(v)) {
                  _specSelected.remove(v);
                } else if (_specSelected.length < 3)
                  _specSelected.add(v);
              }),
            ),
          ],
          const SizedBox(height: 12),
          _FlatField(
            label: t('password'),
            controller: _pass,
            hint: t('password_hint'),
            icon: CupertinoIcons.lock,
            obscure: _obscure,
            onToggleObscure: () => setState(() => _obscure = !_obscure),
            accent: widget.accent,
          ),
          const SizedBox(height: 6),
          Padding(
            padding: const EdgeInsets.only(left: 2),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                _PasswordRule(
                  textKey: 'pass_rule_length',
                  controller: _pass,
                  check: (v) => v.length >= 6,
                ),
                _PasswordRule(
                  textKey: 'pass_rule_digit',
                  controller: _pass,
                  check: (v) => v.contains(RegExp(r'[0-9]')),
                ),
                _PasswordRule(
                  textKey: 'pass_rule_upper',
                  controller: _pass,
                  check: (v) => v.contains(RegExp(r'[A-Z]')),
                ),
                _PasswordRule(
                  textKey: 'pass_rule_special',
                  controller: _pass,
                  check: (v) => v.contains(RegExp(r'[!@#\$%^&*(),.?":{}|<>]')),
                ),
              ],
            ),
          ),
          const SizedBox(height: 12),
          _FlatField(
            label: t('confirm_password'),
            controller: _pass2,
            hint: t('repeat_password'),
            icon: CupertinoIcons.lock_fill,
            obscure: true,
            hasError: !_passMatch,
            accent: widget.accent,
          ),
          if (!_passMatch)
            Padding(
              padding: const EdgeInsets.only(top: 5),
              child: Row(
                children: [
                  const Icon(
                    CupertinoIcons.exclamationmark_circle_fill,
                    color: Color(0xFFFF3B30),
                    size: 13,
                  ),
                  const SizedBox(width: 5),
                  Text(
                    t('passwords_no_match'),
                    style: const TextStyle(
                      fontSize: 12,
                      color: Color(0xFFFF3B30),
                    ),
                  ),
                ],
              ),
            ),
          const SizedBox(height: 16),
          GestureDetector(
            onTap: () => setState(() => _agree = !_agree),
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                AnimatedContainer(
                  duration: const Duration(milliseconds: 150),
                  width: 22,
                  height: 22,
                  decoration: BoxDecoration(
                    gradient: _agree
                        ? LinearGradient(
                            colors: widget.gradColors,
                            begin: Alignment.topLeft,
                            end: Alignment.bottomRight,
                          )
                        : null,
                    color: _agree ? null : const Color(0xFFF2F2F7),
                    borderRadius: BorderRadius.circular(6),
                    border: Border.all(
                      color: _agree
                          ? Colors.transparent
                          : const Color(0xFFD1D1D6),
                      width: 1.5,
                    ),
                  ),
                  child: _agree
                      ? const Icon(Icons.check, color: Colors.white, size: 14)
                      : null,
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: RichText(
                    text: TextSpan(
                      style: const TextStyle(
                        fontSize: 13,
                        color: Color(0xFF8E8E93),
                      ),
                      children: [
                        TextSpan(text: t('agree_text')),
                        TextSpan(
                          text: t('terms'),
                          style: TextStyle(
                            color: widget.accent,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                        TextSpan(text: t('and')),
                        TextSpan(
                          text: t('privacy'),
                          style: TextStyle(
                            color: widget.accent,
                            fontWeight: FontWeight.w600,
                          ),
                        ),
                      ],
                    ),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 24),
          _BigButton(
            label: t('btn_register'),
            gradColors: widget.gradColors,
            accent: widget.accent,
            loading: _loading,
            onTap: _submit,
          ),
          const SizedBox(height: 16),
          Center(
            child: RichText(
              text: TextSpan(
                style: const TextStyle(fontSize: 14),
                children: [
                  TextSpan(
                    text: t('have_account'),
                    style: const TextStyle(color: Color(0xFF8E8E93)),
                  ),
                  TextSpan(
                    text: t('sign_in'),
                    style: TextStyle(
                      color: widget.accent,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
