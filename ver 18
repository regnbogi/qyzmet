class _HotRequestsBanner extends StatelessWidget {
  const _HotRequestsBanner();

  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<List<String>>(
      valueListenable: masterSpecsNotifier,
      builder: (_, specs, _) {
        final testSpecs = specs.isEmpty
            ? ['sub_plumbers', 'sub_electricians']
            : specs;
        final List<Map<String, String>> allRequests = [];
        for (final spec in testSpecs) {
          final requests = hotRequests[spec];
          if (requests != null) allRequests.addAll(requests);
        }
        if (allRequests.isEmpty) return const SizedBox();

        return Padding(
          padding: const EdgeInsets.fromLTRB(16, 14, 16, 4),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Row(
                children: [
                  const Text('🔥', style: TextStyle(fontSize: 18)),
                  const SizedBox(width: 6),
                  Text(
                    'Горящие запросы',
                    style: TextStyle(
                      fontSize: 18,
                      fontWeight: FontWeight.w800,
                      color: gradientNotifier.value[0],
                    ),
                  ),
                  const Spacer(),
                  Text(
                    '${allRequests.length} запросов',
                    style: const TextStyle(
                      fontSize: 13,
                      color: Color(0xFF8E8E93),
                    ),
                  ),
                ],
              ),
              const SizedBox(height: 10),
              ...allRequests.map((req) => _HotRequestCard(request: req)),
            ],
          ),
        );
      },
    );
  }
}

