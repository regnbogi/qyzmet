class AppThemes {
  static const clientSeed = Color(0xFF1A237E);
  static const masterSeed = Color(0xFF00695C);

  static ThemeData get clientTheme => ThemeData(
    brightness: Brightness.light,
    colorScheme: ColorScheme.fromSeed(seedColor: clientSeed),
    useMaterial3: true,
  );

  static ThemeData get clientDarkTheme => ThemeData(
    brightness: Brightness.dark,
    colorScheme: ColorScheme.fromSeed(
      seedColor: clientSeed,
      brightness: Brightness.dark,
    ),
    useMaterial3: true,
  );

  static ThemeData get masterTheme => ThemeData(
    brightness: Brightness.light,
    colorScheme: ColorScheme.fromSeed(seedColor: masterSeed),
    useMaterial3: true,
  );

  static ThemeData get masterDarkTheme => ThemeData(
    brightness: Brightness.dark,
    colorScheme: ColorScheme.fromSeed(
      seedColor: masterSeed,
      brightness: Brightness.dark,
    ),
    useMaterial3: true,
  );
}
