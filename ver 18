class MasterFinderScreen extends StatefulWidget {
  const MasterFinderScreen({super.key});
  @override
  State<MasterFinderScreen> createState() => _MasterFinderScreenState();
}

class _MasterFinderScreenState extends State<MasterFinderScreen> {
  String? _selectedTime;
  int _step = 0;
  String? _selectedCategory;
  String? _selectedSubcategory;
  List<String> _selectedProblems = [];
  String _otherProblem = '';
  String? _selectedWhere;
  String? _selectedWhen;
  final _addressCtrl = TextEditingController();

  @override
  void dispose() {
    _addressCtrl.dispose();
    super.dispose();
  }

  String _stepTitle() {
    switch (_step) {
      case 0:
        return 'В какой сфере\nищете мастера?';
      case 1:
        return 'Выберите\nспециализацию';
      case 2:
        return 'Что нужно\nсделать?';
      case 3:
        return 'Где и когда\nнужен мастер?';
      case 4:
        return 'Укажите\nадрес';
      default:
        return '';
    }
  }

  bool _canProceed() {
    switch (_step) {
      case 0:
        return _selectedCategory != null;
      case 1:
        return _selectedSubcategory != null;
      case 2:
        return _selectedProblems.isNotEmpty || _otherProblem.isNotEmpty;
      case 3:
        final needTime =
            _selectedWhen == 'Сегодня' || _selectedWhen == 'Завтра';
        return _selectedWhere != null &&
            _selectedWhen != null &&
            (!needTime || _selectedTime != null);
      case 4:
        return _addressCtrl.text.trim().length > 3;
      default:
        return false;
    }
  }

  void _next() {
    if (_step < 4) {
      setState(() => _step++);
    } else {
      final cat = categoryData.firstWhere(
        (c) => c['titleKey'] == _selectedCategory,
      );
      Navigator.pushReplacement(
        context,
        CupertinoPageRoute(
          builder: (_) => MastersScreen(
            categoryTitleKey: _selectedCategory!,
            subcategoryKey: _selectedSubcategory!,
            icon: cat['icon'] as IconData,
            cityKey: 'city_almaty',
          ),
        ),
      );
    }
  }

  @override
  Widget build(BuildContext context) {
    return _AppShell(
      grad: gradientNotifier.value,
      showBack: true,
      headerBuilder: (lang) => Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            _stepTitle(),
            style: const TextStyle(
              fontSize: 26,
              fontWeight: FontWeight.w800,
              color: Colors.white,
              letterSpacing: -0.5,
              height: 1.2,
            ),
          ),
          const SizedBox(height: 12),
          Row(
            children: List.generate(
              5,
              (i) => Expanded(
                child: Container(
                  margin: const EdgeInsets.only(right: 4),
                  height: 4,
                  decoration: BoxDecoration(
                    color: i < _step
                        ? Colors.white
                        : (i == _step
                              ? Colors.white.withOpacity(0.6)
                              : Colors.white.withOpacity(0.25)),
                    borderRadius: BorderRadius.circular(2),
                  ),
