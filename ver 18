  Widget _buildAddress() {
    return Padding(
      padding: const EdgeInsets.fromLTRB(20, 24, 20, 8),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            'Укажите ваш адрес',
            style: TextStyle(
              fontSize: 16,
              fontWeight: FontWeight.w700,
              color: darkNotifier.value ? kDarkText : const Color(0xFF1C1C1E),
            ),
          ),
          const SizedBox(height: 6),
          const Text(
            'Мастер приедет к вам',
            style: TextStyle(fontSize: 13, color: Color(0xFF8E8E93)),
          ),
          const SizedBox(height: 20),
          // Кнопка геолокации
          GestureDetector(
            onTap: () async {
              setState(() => _addressCtrl.text = 'Определяем...');
              try {
                if (!await Geolocator.isLocationServiceEnabled()) {
                  setState(() => _addressCtrl.text = '');
                  return;
                }
                LocationPermission p = await Geolocator.checkPermission();
                if (p == LocationPermission.denied) {
                  p = await Geolocator.requestPermission();
                }
                if (p == LocationPermission.deniedForever) {
                  setState(() => _addressCtrl.text = '');
                  return;
                }
                final pos = await Geolocator.getCurrentPosition();
                final cityKey = findNearestCityKey(pos.latitude, pos.longitude);
                setState(() => _addressCtrl.text = '${t(cityKey)}, ');
              } catch (_) {}
            },
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 13),
              decoration: BoxDecoration(
                gradient: LinearGradient(colors: gradientNotifier.value),
                borderRadius: BorderRadius.circular(14),
              ),
              child: Row(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  const Icon(
                    CupertinoIcons.location_fill,
                    color: Colors.white,
                    size: 18,
                  ),
                  const SizedBox(width: 8),
                  const Text(
                    'Определить моё местоположение',
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 15,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ],
              ),
            ),
          ),
          const SizedBox(height: 12),
          // Поле ввода
          Container(
            padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 4),
            decoration: BoxDecoration(
              color: darkNotifier.value ? kDarkCard : const Color(0xFFF7F8FA),
              borderRadius: BorderRadius.circular(14),
              border: Border.all(
                color: _addressCtrl.text.isNotEmpty
                    ? gradientNotifier.value[0]
                    : Colors.transparent,
                width: 2,
              ),
            ),
            child: Row(
              children: [
                Icon(
                  CupertinoIcons.location_fill,
                  size: 20,
                  color: gradientNotifier.value[0],
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: TextField(
                    controller: _addressCtrl,
                    onChanged: (_) => setState(() {}),
                    style: TextStyle(
                      fontSize: 15,
                      color: darkNotifier.value
                          ? kDarkText
                          : const Color(0xFF1C1C1E),
                    ),
                    decoration: const InputDecoration(
                      hintText: 'Улица, дом, квартира',
                      hintStyle: TextStyle(
                        color: Color(0xFF8E8E93),
                        fontSize: 15,
                      ),
                      border: InputBorder.none,
                      isDense: true,
                      contentPadding: EdgeInsets.symmetric(vertical: 14),
                    ),
                  ),
                ),
                if (_addressCtrl.text.isNotEmpty)
                  GestureDetector(
                    onTap: () => setState(() => _addressCtrl.clear()),
                    child: const Icon(
                      CupertinoIcons.xmark_circle_fill,
