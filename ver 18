import 'dart:convert';

void main() => runApp(const MyApp());

class MyApp extends StatelessWidget {
  const MyApp({super.key});
  @override
  Widget build(BuildContext context) {
    return ValueListenableBuilder<bool>(
      valueListenable: darkNotifier,
      builder: (_, isDark, _) => ValueListenableBuilder<String>(
        valueListenable: langNotifier,
        builder: (_, lang, _) => ValueListenableBuilder<String>(
          valueListenable: roleNotifier,
          builder: (_, role, _) {
            final isMaster = role == 'master';
            return MaterialApp(
              title: 'Sheber',
              debugShowCheckedModeBanner: false,
              theme: isMaster ? AppThemes.masterTheme : AppThemes.clientTheme,
              darkTheme: isMaster
                  ? AppThemes.masterDarkTheme
                  : AppThemes.clientDarkTheme,
              themeMode: isDark ? ThemeMode.dark : ThemeMode.light,
              home: const SplashScreen(),
            );
          },
        ),
      ),
    );
  }
}

