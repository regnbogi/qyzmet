String _formatPhone(String input) {
  String d = input.replaceAll(RegExp(r'[^\d]'), '');
  if (d.startsWith('7')) d = d.substring(1);
  if (d.length > 10) d = d.substring(0, 10);
  String r = '+7 ';
  if (d.isEmpty) return r;
  if (d.length <= 3) return '$r($d';
  if (d.length <= 6) return '$r(${d.substring(0, 3)}) ${d.substring(3)}';
  if (d.length <= 8) {
    return '$r(${d.substring(0, 3)}) ${d.substring(3, 6)}-${d.substring(6)}';
  }
  return '$r(${d.substring(0, 3)}) ${d.substring(3, 6)}-${d.substring(6, 8)}-${d.substring(8)}';
}
